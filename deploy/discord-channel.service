[Unit]
Description=Discord Channel (Cursor Agent gateway)
After=network-online.target mihomo.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/discord-channel-cursor
ExecStart=%h/discord-channel-cursor/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
StandardOutput=append:%h/discord-channel-cursor/channel.log
StandardError=append:%h/discord-channel-cursor/channel.log
SyslogIdentifier=discord-channel

[Install]
WantedBy=default.target
