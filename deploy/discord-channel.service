[Unit]
Description=Discord Channel (Cursor Agent gateway)
After=network-online.target mihomo.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/agent-ws
ExecStart=%h/agent-ws/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=append:%h/agent-ws/channel.log
StandardError=append:%h/agent-ws/channel.log
SyslogIdentifier=discord-channel

[Install]
WantedBy=default.target
